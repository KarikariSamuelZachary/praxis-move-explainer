# Canonical base image for the Praxis backend.
#
# Why this exists: every heavy, rarely-changing layer -- apt packages, pip
# dependencies (incl. the Maia-3 package), the Maia-3 checkpoint, and the
# full 3-4-5-man Syzygy set (~984 MB downloaded from the tablebase mirrors)
# -- is built once here and pushed to ACR. The application Dockerfile starts
# FROM this image (digest-pinned), so a deploy adds only the source layer
# instead of re-downloading ~984 MB from Lichess on every push.
#
# Rebuild and push ONLY when requirements.txt, the pre-warm scripts, or
# src/engines change:
#
#   docker build -f Dockerfile.base \
#     -t praxismoveacr.azurecr.io/praxis-base:<new-tag> .
#   docker push praxismoveacr.azurecr.io/praxis-base:<new-tag>
#
# then update the FROM digest in Dockerfile.
#
# Note: the initial `3-4-5-v1` base was seeded by tagging the already
# verified full-set image (290 files / 983,957,920 bytes exec-checked inside
# it), so its layers include a stale source copy that the app's `COPY . .`
# overwrites. Future rebuilds from this file are clean (no source layer) and
# will produce a new digest to pin.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends git stockfish \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --retries 5 --timeout 120 -r requirements.txt

# Full 3-, 4- and 5-man Syzygy set (~984 MB). Downloads carry a 30s socket
# timeout so a stalled mirror fails over instead of hanging the build.
COPY scripts/prewarm_syzygy.py scripts/prewarm_syzygy.py
RUN python scripts/prewarm_syzygy.py

# Maia-3 5M checkpoint + one throwaway inference (validates the wrapper).
COPY scripts/prewarm_maia3.py scripts/prewarm_maia3.py
COPY scripts/maia3_patched_uci.py scripts/maia3_patched_uci.py
COPY src/engines src/engines
RUN python scripts/prewarm_maia3.py
