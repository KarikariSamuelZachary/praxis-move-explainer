# Git / local dev metadata
.git/
.claude/

# Python virtual environment and bytecode
venv/
__pycache__/
*.py[cod]

# Frontend build output and installed dependencies
frontend/.next/
frontend/node_modules/

# Local environment files / secrets
.env
*.env.local
src/.env
frontend/.env.local
url

# Local data and backup artifacts not needed in a production image
data/raw/
praxis_subset.csv

# Generated endgame sourcing artifacts are dev-only: the deploy image ships
# the committed data/seed/endgame_sourced_seed.jsonl.gz instead and imports
# it on first boot when the sourced endgame pool is empty (and data/syzygy is
# already baked into the base image). See src/services/endgame_seeding.py.
data/processed/endgame_candidates/
test_game.pgn
woodpecker-bird-original.png.bak
landing_page mockup image.png

# Syzygy tablebase files are fetched and validated at build time by
# scripts/prewarm_syzygy.py; never copy host-local copies into the image.
data/syzygy/

# Generic local artifacts
*.log
*.db
*.sqlite3
.coverage
.coverage.*
.DS_Store
Thumbs.db
